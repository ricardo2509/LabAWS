FROM mcr.microsoft.com/dotnet/sdk:9.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:9.0  AS build
WORKDIR /src
COPY ["LabAws.Api.csproj", "./"]
RUN dotnet restore "LabAws.Api.csproj"
COPY . .
RUN dotnet build "LabAws.Api.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "LabAws.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "LabAws.Api.dll"]
