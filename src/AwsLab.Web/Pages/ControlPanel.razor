@page "/ControlPanel"

@using System.Net.Http.Headers

@using System.Linq;
@using AwsLab.Web.DTO

@inject HttpClient Http

<div class="container mt-5">
	<div class="card shadow-sm p-4 mb-4">
		<h2 class="text-primary mb-4">Control Panel</h2>

		<div class="row">
			@if (!addingBucket)
			{
				<div class="mb-4 col-12 col-sm-4 col-md-3">
					<button class="btn btn-success w-100" @onclick="ListBuckets">
						🔄 Refresh buckets
					</button>
				</div>
			}

			@if (!creatBucket)
			{
				<div class="mb-4 col-12 col-sm-4 col-md-3">
					<button class="btn btn-success w-100" @onclick="AddBucket">
						🆕 Create Bucket
					</button>
				</div>
			}
		</div>

		@if (creatBucket)
		{
			<div class="row align-items-end g-2 mb-3">
				<div class="col-12 col-md-4">
					<label class="form-label fw-bold">Bucket name</label>
					<input type="text" class="form-control" @bind="newBucket" placeholder="Digite o nome..." />
				</div>

				<div class="col-6 col-md-2">
					<button class="btn btn-primary w-100" @onclick="CreateBucket">Create</button>
				</div>

				<div class="col-6 col-md-2">
					<button class="btn btn-secondary w-100" @onclick="CancelBucket">Cancel</button>
				</div>
			</div>
		}

		@if (!string.IsNullOrEmpty(messageBucketCreated))
		{
			<div class="row">
				<div class="col-12">
					<div class="alert alert-success mt-3">@messageBucketCreated</div>
				</div>
			</div>
		}

		@if (loadingBuckets)
		{
			<div class="alert alert-info">Searching API data...</div>
		}
		else if ((buckets == null || !buckets.Any()) && !string.IsNullOrEmpty(statusMessage))
		{
			<div class="alert alert-warning">@statusMessage</div>
		}
		else if (buckets != null && buckets.Any())
		{
			<ul class="list-group mb-4">
				@foreach (var bucket in buckets)
				{
					<li class="list-group-item d-flex justify-content-between align-items-center mb-2 p-3 bg-light rounded border">
						<strong>@bucket</strong>
						<span class="badge bg-primary rounded-pill">S3 Bucket Active</span>
					</li>
				}
			</ul>

			<!-- FILE UPLOAD SECTION -->
			<div class="border p-4 rounded bg-white shadow-xs mt-4">
				<h4 class="text-secondary mb-3">📤 Upload file</h4>

				<div class="mb-3">
					<label class="form-label">Select bucket:</label>
					<select class="form-select w-50" @bind="selectedBucket">
						<option value="">-- Choose bucket --</option>
						@foreach (var bucket in buckets)
						{
							<option value="@bucket">@bucket</option>
						}
					</select>
				</div>

				<div class="mb-3">
					<label class="form-label">Choose file (expect: ".jpg", ".jpeg", ".png", ".gif", ".txt"):</label>
					<InputFile class="form-control w-50" OnChange="SelectFile" />
				</div>

				<button class="btn btn-secondary" @onclick="SendFile" disabled="@(string.IsNullOrEmpty(selectedBucket) || selectedFile == null || processingUpload)">
					@if (processingUpload)
					{
						<span>Uploading and notifying SQS...</span>
					}
					else
					{
						<span>Send to S3 & SQS</span>
					}
				</button>

				@if (!string.IsNullOrEmpty(statusMessage))
				{
					<div class="alert alert-success mt-3">@statusMessage</div>
				}
			</div>
		}
	</div>
</div>


@code {
	private List<string>? buckets = new List<string>();
	private bool loadingBuckets = false;
	private bool processingUpload = false;

	private string selectedBucket = "";
	private IBrowserFile? selectedFile;
	private string statusMessage = "";

	private bool addingBucket = false;
	private bool creatBucket = false;
	private string newBucket = string.Empty;
	private string messageBucketCreated = string.Empty;

	private string urlGetBuckets = "/api/buckets";
	private string urlCreateBucket = "/api/createBucket";
	private string urlUpload = "/api/uploadFile";
	private string urlNotificar = "/api/notificar-arquivo";

	private void AddBucket()
	{
		addingBucket = true;
		creatBucket = true;
		messageBucketCreated = string.Empty;
		loadingBuckets = false;
		buckets = null;
	}

	private async Task CreateBucket()
	{
		try
		{
			var respostaUpload = await Http.PostAsync($"{urlCreateBucket}?bucketName={newBucket}", null);

			if (respostaUpload.IsSuccessStatusCode)
			{
				messageBucketCreated = $"Bucket '{newBucket}' created on S3";
				await ListBuckets();
				creatBucket = false;
			}
			else
			{
				var erroDto = await respostaUpload.Content.ReadFromJsonAsync<ResponseUpload>();
				messageBucketCreated = erroDto?.Erro ?? "Unknown error.";
			}
		}
		catch (Exception ex)
		{
			messageBucketCreated = $"Error: {ex.Message}";
		}
		finally
		{
			newBucket = string.Empty;
			creatBucket = false;
			addingBucket = false;
		}
	}

	private void CancelBucket()
	{
		newBucket = string.Empty;
		creatBucket = false;
		messageBucketCreated = string.Empty;
		addingBucket = false;
	}

	private async Task ListBuckets()
	{
		loadingBuckets = true;
		try
		{
			buckets = await Http.GetFromJsonAsync<List<string>>(urlGetBuckets);
			if (buckets != null && buckets.Any())
			{
				selectedBucket = buckets.First();
			}
			statusMessage = buckets == null || !buckets.Any() ? "No bucket found." : "";
		}
		catch (Exception ex)
		{
			statusMessage = $"Erro listing AWS: {ex.Message}";
		}
		finally
		{
			loadingBuckets = false;
		}
	}

	private void SelectFile(InputFileChangeEventArgs e)
	{
		selectedFile = e.File;
		statusMessage = "";
	}

	private async Task SendFile()
	{
		if (selectedFile == null || string.IsNullOrEmpty(selectedBucket)) return;

		processingUpload = true;
		statusMessage = "";

		try
		{

			HttpResponseMessage respostaUpload;
			// 1. FAZ O UPLOAD DO ARQUIVO PARA O S3 VIA API
			using (MultipartFormDataContent conteudoFormulario = new MultipartFormDataContent())
			{
				var conteudoArquivo = new StreamContent(selectedFile.OpenReadStream()); // maxAllowedSize: 1024 * 1024 * 5 - Max 5MB (now verified server side)
				conteudoArquivo.Headers.ContentType = new MediaTypeHeaderValue(selectedFile.ContentType);
				conteudoFormulario.Add(conteudoArquivo, "file", selectedFile.Name);

				respostaUpload = await Http.PostAsync($"{urlUpload}?bucketName={selectedBucket}", conteudoFormulario);
			}
			;

			if (respostaUpload.IsSuccessStatusCode)
			{
				// 2. DISPARA A NOTIFICAÇÃO DO SQS VIA API
				var respostaNotificar = await Http.PostAsync($"{urlNotificar}?fileName={selectedFile.Name}&bucketName={selectedBucket}", null);

				if (respostaNotificar.IsSuccessStatusCode)
				{
					statusMessage = $"File '{selectedFile.Name}' saved to S3 and event sent to SQS!";
				}
				else
				{
					var erroDto = await respostaUpload.Content.ReadFromJsonAsync<ResponseUpload>();
					//					statusMensagem = erroDto?.Erro ?? "Erro desconhecido.";
					statusMessage = string.Format("File sent to S3, but failed to generate event in SQS ({0}).", erroDto?.Erro ?? "");
				}
			}
			else
			{
				var erroDto = await respostaUpload.Content.ReadFromJsonAsync<ResponseUpload>();
				statusMessage = erroDto?.Erro ?? "Unknown error.";
			}
		}
		catch (Exception ex)
		{
			statusMessage = $"Error: {ex.Message}";
		}
		finally
		{
			processingUpload = false;
		}
	}
}