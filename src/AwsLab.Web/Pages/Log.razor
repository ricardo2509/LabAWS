@page "/log"
@using AwsLab.Web.DTO

@inject HttpClient Http

@layout MainLayout

<div class="container mt-5">
	<div class="card shadow-sm p-4 mb-4">
		<h2 class="text-primary mb-4">Logs de acesso - AWS Lab</h2>

		<div class="container">
			<div class="row">
				<div class="mb-4 col-4">
					<button class="btn btn-success" @onclick="CarregarLogs">
						🔄 Update Logs List
					</button>
				</div>
			</div>
		</div>

		@if (logsAWS.Any())
		{
			<div class="container">
				<div class="row">
					<table class="table table-hover">
						<thead>
							<tr>
								<th>Date upload</th>
								<th>File</th>
								<th>AWS Id</th>
								<th>Bucket</th>
							</tr>
						</thead>
						@foreach (UploadLogDto l in logsAWS)
						{
							<tbody>
								<tr>
									<td>@l.UploadDate</td>
									<td>@l.FileName</td>
									<td>@l.QueueId</td>
									<td>@l.BucketName</td>
								</tr>
							</tbody>
						}
					</table>
				</div>
			</div>
		}
		else if (loaded)
		{
			<div class="alert alert-warning">@(string.IsNullOrEmpty(statusMensagem) ? "AWS Queue log not found" : statusMensagem)</div>
		}
	</div>
</div>

@code {

	private string urlGetLogs = "/api/logs";
	private string statusMensagem = "";
	private List<UploadLogDto> logsAWS = new List<UploadLogDto>();
	private bool loaded=false	;

	private async Task CarregarLogs()
	{
		try
		{
			statusMensagem = "";
			loaded = true;
			logsAWS = await Http.GetFromJsonAsync<List<UploadLogDto>>(urlGetLogs);
		}
		catch (Exception ex)
		{
			statusMensagem = $"Erro no processo: {ex.Message}";
		}

	}
}