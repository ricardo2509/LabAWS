@page "/log"
@using AwsLab.Web.DTO

@inject HttpClient Http

@layout MainLayout

<div class="container mt-5">
	<div class="card shadow-sm p-4 mb-4">
		<h2 class="text-primary mb-4">Logs de acesso - AWS Lab</h2>

		<div class="container">
			<div class="row">
				<div class="mb-4 col-4">
					<button class="btn btn-success" @onclick="CarregarLogs">
						🔄 Update Logs List
					</button>
				</div>
			</div>
		</div>

		<div class="container">
			<div class="row">
				@foreach (UploadLogDto l in logsAWS)
				{
					<ul>
						<li>
							<span>On <strong>@l.UploadDate</strong></span>
							<span> File:  <strong>@l.FileName</strong></span>
							<span> uploaded on bucket <strong>@l.BucketName</strong></span>
						</li>
					</ul>
				}
			</div>
		</div>
	</div>
</div>

@code {

	private string urlGetLogs = "https://localhost:7215/api/logs";
	private string statusMensagem = "";
	private List<UploadLogDto> logsAWS = new List<UploadLogDto>();

	private async Task CarregarLogs()
    {
        try
        {
            logsAWS = await Http.GetFromJsonAsync<List<UploadLogDto>>(urlGetLogs);
		}
		catch (Exception ex)
		{
			statusMensagem = $"Erro no processo: {ex.Message}";
		}

	}
}
